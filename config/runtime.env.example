# Public listener. Put a TLS reverse proxy in front for Internet exposure.
R740_BIND=127.0.0.1
R740_PORT=8080
R740_DATA_DIR=/var/lib/r740-ai-factory
R740_MODEL_CATALOG=/opt/r740-ai-factory/model-manifests/catalog.json
R740_ADMIN_TOKEN_FILE=/etc/r740-ai-factory/secrets/admin_token

# cpu, nvidia or auto. This controls detection/reporting, not driver installation.
R740_HARDWARE_PROFILE=auto

# Optional OpenAI-compatible backend. Empty means control plane only.
R740_INFERENCE_BASE_URL=
# Optional bearer token for an authenticated OpenAI-compatible backend.
# Store it in a local file; never place the value in this env file or Git.
R740_INFERENCE_API_KEY_FILE=
R740_INFERENCE_TIMEOUT_SECONDS=120

# Explicit comma-separated origins. Empty disables browser cross-origin access.
R740_ALLOWED_ORIGINS=
