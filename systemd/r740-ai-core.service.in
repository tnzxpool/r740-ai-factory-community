# SPDX-License-Identifier: LGPL-3.0-or-later
[Unit]
Description=R740 AI Factory Community @DESCRIPTION@
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=PYTHONPATH=@INSTALL_DIR@/components/core/src
EnvironmentFile=@CONFIG_DIR@/core.env
WorkingDirectory=@STATE_DIR@
ExecStart=@VENV_DIR@/bin/python -m uvicorn r740_core.@MODULE@:app --host 127.0.0.1 --port @PORT@
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE_DIR@ @RUNTIME_DIR@
ReadOnlyPaths=@CONFIG_DIR@ @INSTALL_DIR@
CapabilityBoundingSet=@CAPS@
AmbientCapabilities=@CAPS@
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
