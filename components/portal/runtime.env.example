# Portable storage and explicitly trusted HTTP hosts.
AI_PORTAL_DB=./data/portal.db
AI_ALLOWED_HOSTS=localhost,127.0.0.1
AI_ADMIN_NETWORK=127.0.0.0/8
AI_SESSION_HOURS=8

# First-run setup. Prefer a locally generated secret file; direct hash remains supported.
AI_SETUP_TOKEN_FILE=./secrets/setup_token
AI_SETUP_TOKEN_HASH=

# Core/model/graphics controller. Empty means disabled and API calls fail closed.
AI_CORE_URL=
AI_PORTAL_CORE_KEY_FILE=

# Optional parser.
AI_PARSER_URL=
AI_PARSER_KEY_FILE=./secrets/parser.key

# Optional read-only tools broker.
AI_TOOLS_URL=
AI_TOOLS_TOKEN_FILE=

# Optional sandbox broker.
AI_SANDBOX_URL=
AI_SANDBOX_TOKEN_FILE=

# Optional local MCP policy signing key.
AI_LOCAL_MCP_POLICY_KEY_FILE=./secrets/local-mcp-policy-signing.key

# Experimental routing remains disabled unless deliberately enabled.
AI_AUTOROUTING_UI_ENABLED=0

# Demo access is disabled by default and no credential is distributed.
AI_DEMO_GUEST_ENABLED=0
AI_DEMO_GUEST_USERNAME=guest
AI_DEMO_GUEST_PASSWORD_FILE=./secrets/demo-guest-password

# Retention policy.
AI_CONVERSATION_RETENTION_DAYS=30
AI_AUDIT_RETENTION_DAYS=90
AI_DOCUMENT_RETENTION_DAYS=30
AI_QUARANTINE_RETENTION_DAYS=7
