# No secret value is shipped. Generate independent random values during install.
AI_ORCHESTRATOR_KEY=
AI_BACKEND_KEY=
AI_PORTAL_CORE_KEY=

AI_STATE_DIR=/var/lib/r740-ai-factory
AI_RUNTIME_DIR=/run/r740-ai-factory
AI_MODELS_DIR=/var/lib/r740-ai-factory/models
AI_DOWNLOADS_DIR=/var/lib/r740-ai-factory/downloads
AI_RESULTS_DIR=/var/lib/r740-ai-factory/results
AI_METRICS_DIR=/var/lib/r740-ai-factory/metrics
AI_LIBEXEC_DIR=/usr/libexec/r740-ai-factory
AI_RUNTIME_GROUP=r740-ai

AI_CAPABILITIES_FILE=/var/lib/r740-ai-factory/registry/capabilities.json
AI_MODEL_STATE_FILE=/var/lib/r740-ai-factory/registry/model_state.json
AI_GRAPHICS_STATE_FILE=/var/lib/r740-ai-factory/registry/graphics_state.json
AI_GPU_LOCK_FILE=/run/r740-ai-factory/gpu.lock
AI_WORKFLOW_LOCK_FILE=/run/r740-ai-factory/workflow.lock

AI_BACKEND_URL=http://127.0.0.1:41140
AI_EMBEDDING_URL=http://127.0.0.1:41143
AI_MODEL_MANAGER_URL=http://127.0.0.1:41146
AI_ORCHESTRATOR_URL=http://127.0.0.1:41139
AI_GRAPHICS_MANAGER_URL=http://127.0.0.1:41148
AI_AUTOROUTING_URL=http://127.0.0.1:41155
AI_QWEN36_URL=http://127.0.0.1:41151
AI_QWEN36_HERETIC_URL=http://127.0.0.1:41154
AI_QWEN3VL_URL=http://127.0.0.1:41147
AI_GLM47_URL=http://127.0.0.1:41150
AI_GLM_OCR_URL=http://127.0.0.1:41153

# Local artefacts are downloaded/verified by the installer; none ship in this source tree.
AI_QWEN3_MODEL_PATH=/var/lib/r740-ai-factory/models/qwen3-8b.gguf
AI_QWEN36_MODEL_PATH=/var/lib/r740-ai-factory/models/qwen3.6-35b-a3b.gguf
AI_QWEN3VL_MODEL_PATH=/var/lib/r740-ai-factory/models/qwen3-vl-8b.gguf
AI_QWEN3VL_MMPROJ_PATH=/var/lib/r740-ai-factory/models/qwen3-vl-8b-mmproj.gguf
AI_GLM47_MODEL_PATH=/var/lib/r740-ai-factory/models/glm-4.7-flash.gguf
AI_SDXL_MODEL_DIR=/var/lib/r740-ai-factory/models/stable-diffusion-xl-base-1.0
AI_REALVISXL_DIR=/var/lib/r740-ai-factory/downloads/realvisxl-v5.staging
AI_MODEL_SERVICES_JSON={"qwen3.6-35b-a3b-heretic-iq4xs":"r740-model-qwen36-heretic.service","qwen3.6-35b-a3b-iq4xs":"r740-model-qwen36.service","qwen3-8b":"r740-model-qwen3.service","qwen3-vl-8b":"r740-model-qwen3vl.service","glm-4.7-flash":"r740-model-glm47.service","glm-ocr-q8":"r740-model-glm-ocr.service"}

# Loopback-only defaults. Add a private portal address explicitly at deployment.
AI_GATEWAY_ALLOWED_CLIENTS=127.0.0.1,::1
AI_GATEWAY_TRUSTED_HOSTS=127.0.0.1,localhost,ai-core
AI_AUTOROUTING_LIVE_ENABLED=0
AI_GRAPHICS_WARM_TTL=600
AI_GRAPHICS_MAX_QUEUE=8
