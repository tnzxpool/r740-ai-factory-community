AI_TOOLS_TOKEN_FILE=/etc/r740-ai-factory/tools/internal.token
# The launcher must read AI_TOOLS_TOKEN from the file above; never commit it.
AI_TOOLS_BIND=127.0.0.1
AI_TOOLS_PORT=41149
AI_TOOLS_DB=/var/lib/r740-ai-factory/tools/state.db
AI_TOOLS_SEARXNG=http://127.0.0.1:8080
AI_TOOLS_DEFAULT_DAILY_LIMIT=20
AI_TOOLS_MAX_SEARCH_RESULTS=8
AI_TOOLS_TIMEOUT_SECONDS=10
AI_TOOLS_MAX_BYTES=1048576
AI_TOOLS_TRUSTED_CLIENT_IPS=127.0.0.1
AI_TOOLS_ALLOWED_ORIGINS=

