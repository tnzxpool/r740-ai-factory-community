AI_SANDBOX_TOKEN_FILE=/etc/r740-ai-factory/sandbox/internal.token
# The launcher must read AI_SANDBOX_TOKEN from the file above; never commit it.
AI_SANDBOX_BIND=127.0.0.1
AI_SANDBOX_PORT=41160
AI_SANDBOX_TRUSTED_CLIENTS=127.0.0.1
AI_SANDBOX_ROOT=/srv/r740-ai-sandbox/users
AI_SANDBOX_DB=/var/lib/r740-ai-factory/sandbox/state.db
AI_SANDBOX_QUOTA_MOUNT=/srv/r740-ai-sandbox
AI_SANDBOX_RUNNER=sandbox-runner
AI_SANDBOX_RUNNER_UID=1001
AI_SANDBOX_PROJECT_MIN=20001
AI_SANDBOX_PROJECT_MAX=20010
AI_SANDBOX_TIMEOUT_SECONDS=60
AI_SANDBOX_IMAGE=docker.io/library/python@sha256:25976e9d34a0fab1f278cae931f34c8303d97bf0c0d7f85b6b4dcf641d7702a4

